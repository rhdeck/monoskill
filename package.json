{
  "name": "monoskill",
  "version": "0.3.2",
  "description": "Compile a repository of agent skills into one provenance-aware router skill.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statechange/monoskill.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "bin": {
    "monoskill": "bin/monoskill.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "test": "node --test && npm run validate:skill",
    "check": "node --check bin/monoskill.js && node --check src/*.js && node --check scripts/*.js && node --check website/*.js",
    "validate:skill": "node scripts/validate-skill.js",
    "website:build": "node website/build.js",
    "website:serve": "node website/server.js",
    "website:test": "playwright test --config website/playwright.config.js",
    "release:preflight": "node scripts/release-preflight.js",
    "release:simulate": "npm test && npm run check && node scripts/release-preflight.js --simulate && npm run smoke:packed",
    "smoke:registry": "node scripts/smoke-registry-release.js",
    "smoke:packed": "node scripts/smoke-packed-cli.js",
    "prepublishOnly": "npm run release:preflight"
  },
  "keywords": [
    "agent-skills",
    "codex",
    "claude",
    "skills",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "2.8.3",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "semver": "^7.7.2",
    "yauzl": "^3.4.0"
  }
}
